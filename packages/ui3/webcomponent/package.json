{
  "name": "@authfly/webcomponent-ui3",
  "version": "0.4.0-pilot.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.7.0"
  },
  "description": "Authfly widgets as light-DOM custom elements on UI8Kit 3 primitives (pilot)",
  "license": "MIT",
  "exports": {
    ".": "./src/authfly.ts",
    "./define": "./src/define.ts",
    "./dist/*": "./dist/*",
    "./*": "./src/*"
  },
  "files": [
    "src",
    "dist"
  ],
  "peerDependencies": {
    "@authfly/core": "^1.0.0"
  },
  "peerDependenciesMeta": {
    "@authfly/core": {
      "optional": true
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build": "bun build src/define.ts --outfile dist/authfly-elements.js --minify --target browser --format esm",
    "test": "bun tests/render.ts && bun test",
    "check:kit": "npx ui8kit@3 check"
  },
  "devDependencies": {
    "typescript": "^5",
    "happy-dom": "^15",
    "@types/bun": "latest"
  }
}
