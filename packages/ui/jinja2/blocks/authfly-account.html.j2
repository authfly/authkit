{#- Authfly account on UI8Kit 3 primitives. Props (p): id, title, text, name, email, verified, methods, labels,
    signoutUrl, csrf, landmarkLabel. -#}
{%- import 'authfly/components.html.j2' as af -%}
{%- set id = p.id or '' -%}{%- set l = p.labels or {} -%}{%- set verified = p.verified or false -%}
{%- set nameRow -%}{{ af.box('dt', af_text('muted'), {}, af_esc(l.name or '')) }}{{ af.box('dd', 'm-0 font-semibold text-foreground', {'data-testid': 'profile-name'}, af_esc(p.name or '')) }}{%- endset -%}
{%- set emailVal -%}{{ p.email or '' }}{{ af.badge('default' if verified else 'secondary', 'verified', (l.verified or '') if verified else (l.unverified or '')) }}{%- endset -%}
{%- set emailRow -%}{{ af.box('dt', af_text('muted'), {}, af_esc(l.email or '')) }}{{ af.box('dd', 'm-0 flex flex-wrap items-center gap-2 font-semibold text-foreground', {'data-testid': 'profile-email'}, emailVal) }}{%- endset -%}
{%- set profile -%}{{ af.box('', 'grid gap-2', {}, nameRow) }}{{ af.box('', 'grid gap-2', {}, emailRow) }}{%- endset -%}
{%- set items -%}
{%- for m in p.methods or [] -%}
{%- set lead -%}{{ af.icon(m.icon or 'shield') }}{{ m.title or '' }}{%- endset -%}
{%- set li -%}{{ af.text('span', 'flex items-center gap-2', {}, lead) }}{{ af.badge('outline', '', m.text or '') }}{%- endset -%}
{{ af.box('li', 'flex items-center justify-between gap-4 text-sm text-foreground', {'data-method': m.id or none}, li) }}
{%- endfor -%}
{%- endset -%}
{%- set methods -%}{{ af.title(2, id ~ '-methods', '', l.security or '') }}{{ af.box('ul', 'm-0 flex list-none flex-col gap-2 p-0', {'aria-labelledby': id ~ '-methods', 'data-testid': 'methods'}, items) }}{%- endset -%}
{%- set out -%}{{ af.icon('log-out') }}{{ l.signout or '' }}{%- endset -%}
{%- set signout -%}{{ af.hidden('csrf', p.csrf or '') }}{{ af.button('', 'submit', af_skin('button', 'outline', 'w-full'), {'data-testid': 'signout'}, out) }}{%- endset -%}
{%- set body -%}
{{ af.head(id, p.title or '', p.text or '') }}
{{- af.box('dl', 'm-0 grid gap-4', {'data-testid': 'profile'}, profile) }}
{{- af.prim('ui/separator/separator.html.j2', {'Decorative': true, 'Class': 'w-full border-border'}) }}
{{- af.stack('2', '', '', '', {}, methods) }}
{{- af.form(p.signoutUrl or '', '', {'data-testid': 'signout-form'}, signout) }}
{%- endset -%}
{{ af.card('max-w-lg', {'data-testid': 'authfly-account', 'aria-labelledby': none if p.landmarkLabel else id ~ '-title', 'aria-label': p.landmarkLabel or none}, body) }}
