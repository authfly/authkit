{#- Authfly request on UI8Kit 3 primitives: kind email (forgot) | password (reset, token hidden) | code.
    Props (p): id, title, text, action, csrf, error, info, labels, token, kind, landmarkLabel. -#}
{%- import 'authfly/components.html.j2' as af -%}
{%- set id = p.id or '' -%}{%- set l = p.labels or {} -%}{%- set error = p.error or '' -%}
{%- set formError = id ~ '-error' if error else none -%}
{%- set kind = p.kind or 'email' -%}
{%- set form -%}
{{ af.hidden('csrf', p.csrf or '') }}
{%- if kind == 'email' -%}
{{ af.field({'label': l.field or '', 'for': id ~ '-email', 'formError': formError, 'input': {'type': 'email', 'name': 'email', 'required': true, 'attrs': {'autocomplete': 'email'}}}) }}
{%- elif kind == 'password' -%}
{{ af.hidden('token', p.token or '') }}
{{- af.field({'label': l.field or '', 'for': id ~ '-password', 'formError': formError, 'input': {'type': 'password', 'name': 'password', 'required': true, 'attrs': {'autocomplete': 'new-password'}}}) }}
{{- af.field({'label': l.confirm or '', 'for': id ~ '-confirm', 'formError': formError, 'input': {'type': 'password', 'name': 'confirm', 'required': true, 'attrs': {'autocomplete': 'new-password'}}}) }}
{%- elif kind == 'code' -%}
{{ af.field({'label': l.field or '', 'for': id ~ '-code', 'formError': formError, 'input': {'type': 'text', 'name': 'code', 'required': true, 'attrs': {'inputmode': 'numeric', 'autocomplete': 'one-time-code'}}}) }}
{%- endif -%}
{{ af.button('', 'submit', af_skin('button', 'default', 'w-full'), {'data-testid': 'submit'}, af_esc(l.submit or '')) }}
{%- endset -%}
{%- set body -%}
{{ af.head(id, p.title or '', p.text or '') }}
{{- af.messages(id, error, p.info or '') }}
{{- af.form(p.action or '', '', {'data-testid': 'authfly-form'}, form) }}
{%- if l.back or '' %}{{ af.link(l.backHref or '', af_skin('link', 'w-fit text-sm'), 'back', l.back) }}{% endif -%}
{%- endset -%}
{{ af.card(af_skin('widgetCard'), {'data-testid': 'authfly-request', 'aria-labelledby': none if p.landmarkLabel else id ~ '-title', 'aria-label': p.landmarkLabel or none}, body) }}
