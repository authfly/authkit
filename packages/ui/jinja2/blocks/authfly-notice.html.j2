{#- Authfly notice on UI8Kit 3 primitives. Props (p): id, title, text, detail, icon, labels, actionUrl, csrf,
    tone (default|success|error), action (link|form), landmarkLabel. -#}
{%- import 'authfly/components.html.j2' as af -%}
{%- set id = p.id or '' -%}{%- set l = p.labels or {} -%}
{%- set tone = p.tone or 'default' -%}{%- set isError = tone == 'error' -%}
{%- set detail -%}{% if p.detail or '' %}{{ af.text('', 'text-sm font-semibold text-foreground', {'data-testid': 'detail'}, af_esc(p.detail)) }}{% endif %}{%- endset -%}
{%- set body -%}
{{ af.icon_badge(p.icon or 'mail-check', 'destructive' if isError else 'default') }}
{{- af.head(id, p.title or '', p.text or '', 'center', 'alert' if isError else 'status', detail) }}
{%- if (p.action or 'link') == 'form' -%}
{%- set f -%}{{ af.hidden('csrf', p.csrf or '') }}{{ af.button('', 'submit', af_skin('button', 'default', 'w-full'), {'data-testid': 'submit'}, af_esc(l.cta or '')) }}{%- endset -%}
{{ af.form(p.actionUrl or '', 'w-full', {'data-testid': 'authfly-form'}, f) }}
{%- else -%}
{{ af.button(l.ctaHref or '', '', af_skin('button', 'default', 'w-full'), {'data-testid': 'cta'}, af_esc(l.cta or '')) }}
{%- endif -%}
{%- if l.secondary or '' %}{{ af.link(l.secondaryHref or '', af_skin('link', 'text-sm'), 'secondary', l.secondary) }}{% endif -%}
{%- endset -%}
{{ af.card('items-center text-center', {'data-testid': 'authfly-notice', 'data-tone': tone, 'aria-labelledby': none if p.landmarkLabel else id ~ '-title', 'aria-label': p.landmarkLabel or none}, body) }}
