{#- Authfly OIDC consent on UI8Kit 3 primitives. Props (p): id, title, text, action, csrf, error, info, client,
    account, scopes, labels, landmarkLabel. -#}
{%- import 'authfly/components.html.j2' as af -%}
{%- set id = p.id or '' -%}{%- set l = p.labels or {} -%}
{%- set acc -%}{{ l.account or '' }} {{ af.text('strong', 'font-semibold', {}, af_esc(p.account or '')) }}{%- endset -%}
{%- set items -%}
{%- for s in p.scopes or [] -%}
{%- set c -%}{{ af.icon('check') }}{{ s.title or '' }}{%- endset -%}
{{ af.box('li', 'flex items-center gap-2 text-sm text-foreground', {'data-scope': s.id or none}, c) }}
{%- endfor -%}
{%- endset -%}
{%- set scopes -%}{{ af.title(2, id ~ '-scopes', '', l.scopes or '') }}{{ af.box('ul', 'm-0 flex list-none flex-col gap-2 p-0', {'aria-labelledby': id ~ '-scopes', 'data-testid': 'scopes'}, items) }}{%- endset -%}
{%- set deny -%}{{ af.hidden('csrf', p.csrf or '') }}{{ af.hidden('decision', 'deny') }}{{ af.button('', 'submit', af_skin('button', 'outline', 'w-full'), {}, af_esc(l.deny or '')) }}{%- endset -%}
{%- set approve -%}{{ af.hidden('csrf', p.csrf or '') }}{{ af.hidden('decision', 'approve') }}{{ af.button('', 'submit', af_skin('button', 'default', 'w-full'), {}, af_esc(l.approve or '')) }}{%- endset -%}
{%- set row -%}{{ af.form(p.action or '', 'flex-1', {'data-testid': 'deny'}, deny) }}{{ af.form(p.action or '', 'flex-1', {'data-testid': 'approve'}, approve) }}{%- endset -%}
{%- set body -%}
{{ af.head(id, p.title or '', p.text or '') }}
{{- af.messages(id, p.error or '', p.info or '') }}
{{- af.text('', 'text-sm text-foreground', {'data-testid': 'account'}, acc) }}
{{- af.stack('2', '', '', '', {}, scopes) }}
{{- af.group('2', '', 'between', '', {}, row) }}
{%- endset -%}
{{ af.card(af_skin('widgetCard'), {'data-testid': 'authfly-consent', 'data-client': p.client or none, 'aria-labelledby': none if p.landmarkLabel else id ~ '-title', 'aria-label': p.landmarkLabel or none}, body) }}
