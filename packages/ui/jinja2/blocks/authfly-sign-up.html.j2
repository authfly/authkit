{#- Authfly sign-up on UI8Kit 3 primitives. Props (p): id, title, text, action, csrf, error, info, labels,
    terms (show|none), landmarkLabel. -#}
{%- import 'authfly/components.html.j2' as af -%}
{%- set id = p.id or '' -%}{%- set l = p.labels or {} -%}{%- set error = p.error or '' -%}
{%- set formError = id ~ '-error' if error else none -%}
{%- set domain = l.domain or '' -%}
{%- set suffix -%}{% if domain %}{{ af.text('span', af_text('muted'), {'id': id ~ '-domain', 'data-testid': 'domain'}, af_esc(domain)) }}{% endif %}{%- endset -%}
{%- set form -%}
{{ af.hidden('csrf', p.csrf or '') }}
{{- af.field({'label': l.name or '', 'for': id ~ '-name', 'formError': formError, 'input': {'type': 'text', 'name': 'name', 'attrs': {'autocomplete': 'name'}}}) }}
{{- af.field({'label': l.username or '', 'for': id ~ '-username', 'formError': formError, 'describe': id ~ '-domain' if domain else none, 'suffix': suffix, 'input': {'type': 'text', 'name': 'username', 'required': true, 'attrs': {'autocomplete': 'username'}}}) }}
{{- af.field({'label': l.password or '', 'for': id ~ '-password', 'hint': l.hint or '', 'formError': formError, 'input': {'type': 'password', 'name': 'password', 'required': true, 'attrs': {'autocomplete': 'new-password'}}}) }}
{%- if (p.terms or 'show') == 'show' -%}
{%- set t -%}
{{ af.prim('ui/checkbox/checkbox.html.j2', {'Name': 'terms', 'Required': true, 'ID': id ~ '-terms', 'Class': af_skin('checkbox')}) }}
{{- af.prim('ui/label/label.html.j2', {'For': id ~ '-terms', 'Class': af_skin('label', 'font-normal')}, af_esc(l.terms or '')) }}
{%- endset -%}
{{ af.group('2', '', '', 'w-fit', {}, t) }}
{%- endif -%}
{{ af.button('', 'submit', af_skin('button', 'default', 'w-full'), {'data-testid': 'submit'}, af_esc(l.submit or '')) }}
{%- endset -%}
{%- set body -%}
{{ af.head(id, p.title or '', p.text or '') }}
{{- af.messages(id, error, p.info or '') }}
{{- af.form(p.action or '', '', {'data-testid': 'authfly-form'}, form) }}
{%- if l.signinLink or '' -%}
{%- set foot -%}{{ l.signinText or '' }} {{ af.link(l.signinHref or '', af_skin('link'), 'signin-link', l.signinLink) }}{%- endset -%}
{{ af.text('', af_text('muted'), {}, foot) }}
{%- endif -%}
{%- endset -%}
{{ af.card(af_skin('widgetCard'), {'data-testid': 'authfly-sign-up', 'aria-labelledby': none if p.landmarkLabel else id ~ '-title', 'aria-label': p.landmarkLabel or none}, body) }}
