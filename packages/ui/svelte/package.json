{
  "name": "@authfly/svelte",
  "version": "0.4.0",
  "type": "module",
  "dependencies": {
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.7.0"
  },
  "description": "Authfly widgets for Svelte 5 on UI8Kit 3 primitives",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/authfly/authkit.git",
    "directory": "packages/ui/svelte"
  },
  "license": "MIT",
  "svelte": "./src/authfly.ts",
  "exports": {
    ".": {
      "svelte": "./src/authfly.ts",
      "default": "./src/authfly.ts"
    },
    "./*": "./src/*"
  },
  "files": [
    "src"
  ],
  "peerDependencies": {
    "@authfly/core": "^1.0.0",
    "svelte": "^5"
  },
  "peerDependenciesMeta": {
    "@authfly/core": {
      "optional": true
    }
  },
  "scripts": {
    "typecheck": "svelte-check --tsconfig ./tsconfig.json --threshold error",
    "test": "bun tests/render.ts && bun test",
    "check:kit": "npx ui8kit@3 check"
  },
  "devDependencies": {
    "svelte": "^5",
    "@sveltejs/vite-plugin-svelte": "^5",
    "vite": "^6",
    "svelte-check": "^4",
    "typescript": "^5"
  },
  "publishConfig": {
    "access": "public"
  }
}
