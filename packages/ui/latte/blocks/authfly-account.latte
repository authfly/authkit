{* Authfly account on UI8Kit 3 primitives. Props ($p): id, title, text, name, email, verified, methods, labels,
   signoutUrl, csrf, landmarkLabel. *}
{import '../authfly/components.latte'}
{var $id = $p['id'] ?? ''}{var $l = $p['labels'] ?? []}{var $error = $p['error'] ?? ''}
{var $formError = $error ? $id . '-error' : null}
{var $lm = ['aria-labelledby' => ($p['landmarkLabel'] ?? '') ? null : $id . '-title', 'aria-label' => $p['landmarkLabel'] ?? null]}
{var $verified = (bool) ($p['verified'] ?? false)}
{capture $nameRow}{include box, 'dt', afText('muted'), [], afEsc($l['name'] ?? '')}{include box, 'dd', 'm-0 font-semibold text-foreground', ['data-testid' => 'profile-name'], afEsc($p['name'] ?? '')}{/capture}
{capture $emailVal}{$p['email'] ?? ''}{include badge, $verified ? 'default' : 'secondary', 'verified', $verified ? ($l['verified'] ?? '') : ($l['unverified'] ?? '')}{/capture}
{capture $emailRow}{include box, 'dt', afText('muted'), [], afEsc($l['email'] ?? '')}{include box, 'dd', 'm-0 flex flex-wrap items-center gap-2 font-semibold text-foreground', ['data-testid' => 'profile-email'], $emailVal}{/capture}
{capture $profile}{include box, '', 'grid gap-2', [], $nameRow}{include box, '', 'grid gap-2', [], $emailRow}{/capture}
{capture $items}{foreach $p['methods'] ?? [] as $m}{capture $lead}{include icon, ($m['icon'] ?? '') ?: 'shield'}{$m['title'] ?? ''}{/capture}{capture $li}{include text, 'span', 'flex items-center gap-2', [], $lead}{include badge, 'outline', '', $m['text'] ?? ''}{/capture}{include box, 'li', 'flex items-center justify-between gap-4 text-sm text-foreground', ['data-method' => $m['id'] ?? null], $li}{/foreach}{/capture}
{capture $methods}{include title, 2, $id . '-methods', null, $l['security'] ?? ''}{include box, 'ul', 'm-0 flex list-none flex-col gap-2 p-0', ['aria-labelledby' => $id . '-methods', 'data-testid' => 'methods'], $items}{/capture}
{capture $out}{include icon, 'log-out'}{$l['signout'] ?? ''}{/capture}
{capture $signout}{include hidden, 'csrf', $p['csrf'] ?? ''}{include button, '', 'submit', afSkin('button', 'outline', 'w-full'), ['data-testid' => 'signout'], $out}{/capture}
{capture $body}
{include head, $id, $p['title'] ?? '', $p['text'] ?? ''}
{include box, 'dl', 'm-0 grid gap-4', ['data-testid' => 'profile'], $profile}
{include '../ui/separator/Separator.latte', decorative: true, class: 'w-full border-border'}
{include stack, '2', '', '', '', [], $methods}
{include form, $p['signoutUrl'] ?? '', '', ['data-testid' => 'signout-form'], $signout}
{/capture}
{include card, afSkin('widgetCard', 'max-w-lg'), ['data-testid' => 'authfly-account'] + $lm, $body}
