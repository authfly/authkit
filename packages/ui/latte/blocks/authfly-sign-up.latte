{* Authfly sign-up on UI8Kit 3 primitives. Props ($p): id, title, text, action, csrf, error, info, labels,
   terms (show|none), landmarkLabel. *}
{import '../authfly/components.latte'}
{var $id = $p['id'] ?? ''}{var $l = $p['labels'] ?? []}{var $error = $p['error'] ?? ''}
{var $formError = $error ? $id . '-error' : null}
{var $lm = ['aria-labelledby' => ($p['landmarkLabel'] ?? '') ? null : $id . '-title', 'aria-label' => $p['landmarkLabel'] ?? null]}
{var $domain = $l['domain'] ?? ''}
{capture $suffix}{if $domain}{include text, 'span', afText('muted'), ['id' => $id . '-domain', 'data-testid' => 'domain'], afEsc($domain)}{/if}{/capture}
{capture $form}
{include hidden, 'csrf', $p['csrf'] ?? ''}
{include field, ['label' => $l['name'] ?? '', 'for' => $id . '-name', 'formError' => $formError, 'input' => ['type' => 'text', 'name' => 'name', 'attrs' => ['autocomplete' => 'name']]]}
{include field, ['label' => $l['username'] ?? '', 'for' => $id . '-username', 'formError' => $formError, 'describe' => $domain ? $id . '-domain' : null, 'suffix' => (string) $suffix, 'input' => ['type' => 'text', 'name' => 'username', 'required' => true, 'attrs' => ['autocomplete' => 'username']]]}
{include field, ['label' => $l['password'] ?? '', 'for' => $id . '-password', 'hint' => $l['hint'] ?? '', 'formError' => $formError, 'input' => ['type' => 'password', 'name' => 'password', 'required' => true, 'attrs' => ['autocomplete' => 'new-password']]]}
{if ($p['terms'] ?? 'show') === 'show'}
{capture $t}{include '../ui/checkbox/Checkbox.latte', name: 'terms', required: true, id: $id . '-terms', class: afSkin('checkbox')}{include '../ui/label/Label.latte', htmlFor: $id . '-terms', class: afSkin('label', 'font-normal'), children: (string) afEsc($l['terms'] ?? '')}{/capture}
{include group, '2', '', '', 'w-fit', [], $t}
{/if}
{include button, '', 'submit', afSkin('button', 'default', 'w-full'), ['data-testid' => 'submit'], afEsc($l['submit'] ?? '')}
{/capture}
{capture $body}
{include head, $id, $p['title'] ?? '', $p['text'] ?? ''}
{include messages, $id, $error, $p['info'] ?? ''}
{include form, $p['action'] ?? '', '', ['data-testid' => 'authfly-form'], $form}
{if $l['signinLink'] ?? ''}{capture $foot}{$l['signinText'] ?? ''} {include link, $l['signinHref'] ?? '', afSkin('link'), 'signin-link', $l['signinLink']}{/capture}{include text, '', afText('muted'), [], $foot}{/if}
{/capture}
{include card, afSkin('widgetCard'), ['data-testid' => 'authfly-sign-up'] + $lm, $body}
