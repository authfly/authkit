{* Authfly sign-in on UI8Kit 3 primitives. Props ($p): id, title, text, action, csrf, error, labels, providers,
   method (password|magic), identifier (any|email|username), social (none|show), landmarkLabel. *}
{import '../authfly/components.latte'}
{var $id = $p['id'] ?? ''}{var $l = $p['labels'] ?? []}{var $error = $p['error'] ?? ''}
{var $formError = $error ? $id . '-error' : null}
{var $lm = ['aria-labelledby' => ($p['landmarkLabel'] ?? '') ? null : $id . '-title', 'aria-label' => $p['landmarkLabel'] ?? null]}
{var $email = ($p['identifier'] ?? 'any') === 'email'}
{capture $providers}{foreach $p['providers'] ?? [] as $pr}{capture $c}{include icon, $pr['icon'] ?? ''}{$pr['title'] ?? ''}{/capture}{include button, ($l['socialUrl'] ?? '') . '/' . ($pr['id'] ?? ''), '', afSkin('button', 'outline', 'w-full'), ['data-provider' => $pr['id'] ?? null], $c}{/foreach}{/capture}
{capture $form}
{include hidden, 'csrf', $p['csrf'] ?? ''}
{include field, ['label' => $l['identifier'] ?? '', 'for' => $id . '-identifier', 'formError' => $formError, 'input' => ['type' => $email ? 'email' : 'text', 'name' => 'identifier', 'required' => true, 'attrs' => ['autocomplete' => $email ? 'email' : 'username']]]}
{if ($p['method'] ?? 'password') === 'password'}
{include field, ['label' => $l['password'] ?? '', 'for' => $id . '-password', 'formError' => $formError, 'input' => ['type' => 'password', 'name' => 'password', 'required' => true, 'attrs' => ['autocomplete' => 'current-password']]]}
{if $l['forgot'] ?? ''}{include link, $l['forgotHref'] ?? '', afSkin('link', 'w-fit text-sm'), 'forgot', $l['forgot']}{/if}
{/if}
{include button, '', 'submit', afSkin('button', 'default', 'w-full'), ['data-testid' => 'submit'], afEsc($l['submit'] ?? '')}
{/capture}
{capture $body}
{include head, $id, $p['title'] ?? '', $p['text'] ?? ''}
{include messages, $id, $error, ''}
{if ($p['social'] ?? 'none') === 'show'}{include stack, '2', '', '', '', ['role' => 'group', 'aria-label' => $l['providers'] ?? null, 'data-testid' => 'authfly-providers'], $providers}{/if}
{include form, $p['action'] ?? '', '', ['data-testid' => 'authfly-form'], $form}
{if $l['magic'] ?? ''}{include button, $l['magicHref'] ?? '', '', afSkin('button', 'outline', 'w-full'), ['data-testid' => 'switch-method'], afEsc($l['magic'])}{/if}
{if $l['signupLink'] ?? ''}{capture $foot}{$l['signupText'] ?? ''} {include link, $l['signupHref'] ?? '', afSkin('link'), 'signup-link', $l['signupLink']}{/capture}{include text, '', afText('muted'), [], $foot}{/if}
{/capture}
{include card, afSkin('widgetCard'), ['data-testid' => 'authfly-sign-in'] + $lm, $body}
