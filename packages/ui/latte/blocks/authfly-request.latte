{* Authfly request on UI8Kit 3 primitives: kind email | password (token hidden) | code. Props ($p): id, title, text,
   action, csrf, error, info, labels, token, kind, landmarkLabel. *}
{import '../authfly/components.latte'}
{var $id = $p['id'] ?? ''}{var $l = $p['labels'] ?? []}{var $error = $p['error'] ?? ''}
{var $formError = $error ? $id . '-error' : null}
{var $lm = ['aria-labelledby' => ($p['landmarkLabel'] ?? '') ? null : $id . '-title', 'aria-label' => $p['landmarkLabel'] ?? null]}
{var $kind = $p['kind'] ?? 'email'}
{capture $form}
{include hidden, 'csrf', $p['csrf'] ?? ''}
{if $kind === 'email'}
{include field, ['label' => $l['field'] ?? '', 'for' => $id . '-email', 'formError' => $formError, 'input' => ['type' => 'email', 'name' => 'email', 'required' => true, 'attrs' => ['autocomplete' => 'email']]]}
{elseif $kind === 'password'}
{include hidden, 'token', $p['token'] ?? ''}
{include field, ['label' => $l['field'] ?? '', 'for' => $id . '-password', 'formError' => $formError, 'input' => ['type' => 'password', 'name' => 'password', 'required' => true, 'attrs' => ['autocomplete' => 'new-password']]]}
{include field, ['label' => $l['confirm'] ?? '', 'for' => $id . '-confirm', 'formError' => $formError, 'input' => ['type' => 'password', 'name' => 'confirm', 'required' => true, 'attrs' => ['autocomplete' => 'new-password']]]}
{elseif $kind === 'code'}
{include field, ['label' => $l['field'] ?? '', 'for' => $id . '-code', 'formError' => $formError, 'input' => ['type' => 'text', 'name' => 'code', 'required' => true, 'attrs' => ['inputmode' => 'numeric', 'autocomplete' => 'one-time-code']]]}
{/if}
{include button, '', 'submit', afSkin('button', 'default', 'w-full'), ['data-testid' => 'submit'], afEsc($l['submit'] ?? '')}
{/capture}
{capture $body}
{include head, $id, $p['title'] ?? '', $p['text'] ?? ''}
{include messages, $id, $error, $p['info'] ?? ''}
{include form, $p['action'] ?? '', '', ['data-testid' => 'authfly-form'], $form}
{if $l['back'] ?? ''}{include link, $l['backHref'] ?? '', afSkin('link', 'w-fit text-sm'), 'back', $l['back']}{/if}
{/capture}
{include card, '', ['data-testid' => 'authfly-request'] + $lm, $body}
