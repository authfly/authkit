{* Authfly notice on UI8Kit 3 primitives. Props ($p): id, title, text, detail, icon, labels, actionUrl, csrf,
   tone (default|success|error), action (link|form), landmarkLabel. *}
{import '../authfly/components.latte'}
{var $id = $p['id'] ?? ''}{var $l = $p['labels'] ?? []}{var $error = $p['error'] ?? ''}
{var $formError = $error ? $id . '-error' : null}
{var $lm = ['aria-labelledby' => ($p['landmarkLabel'] ?? '') ? null : $id . '-title', 'aria-label' => $p['landmarkLabel'] ?? null]}
{var $tone = $p['tone'] ?? 'default'}{var $isError = $tone === 'error'}
{capture $detail}{if $p['detail'] ?? ''}{include text, '', 'text-sm font-semibold text-foreground', ['data-testid' => 'detail'], afEsc($p['detail'])}{/if}{/capture}
{capture $body}
{include iconBadge, $p['icon'] ?? 'mail-check', $isError ? 'destructive' : 'default'}
{include head, $id, $p['title'] ?? '', $p['text'] ?? '', 'center', $isError ? 'alert' : 'status', $detail}
{if ($p['action'] ?? 'link') === 'form'}
{capture $f}{include hidden, 'csrf', $p['csrf'] ?? ''}{include button, '', 'submit', afSkin('button', 'default', 'w-full'), ['data-testid' => 'submit'], afEsc($l['cta'] ?? '')}{/capture}
{include form, $p['actionUrl'] ?? '', 'w-full', ['data-testid' => 'authfly-form'], $f}
{else}
{include button, $l['ctaHref'] ?? '', '', afSkin('button', 'default', 'w-full'), ['data-testid' => 'cta'], afEsc($l['cta'] ?? '')}
{/if}
{if $l['secondary'] ?? ''}{include link, $l['secondaryHref'] ?? '', afSkin('link', 'text-sm'), 'secondary', $l['secondary']}{/if}
{/capture}
{include card, 'items-center text-center', ['data-testid' => 'authfly-notice', 'data-tone' => $tone] + $lm, $body}
