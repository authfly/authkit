// The Authfly widgets on UI8Kit 3 primitives for templ (sign-in, sign-up, request, notice: generated, authfly_<name>.templ). Props keep the xgen templ API (see props.go);
// markup mirrors packages/ui/react/src/blocks one to one.
package authfly

import (
	"github.com/authfly/authkit/packages/ui/templ/ui/box"
	"github.com/authfly/authkit/packages/ui/templ/ui/button"
	"github.com/authfly/authkit/packages/ui/templ/ui/link"
	"github.com/authfly/authkit/packages/ui/templ/ui/separator"
	"github.com/authfly/authkit/packages/ui/templ/ui/text"
)

func field(f func(FieldControl) templ.Component) func(FieldControl) templ.Component { return f }

templ authLink(href, class, testid, label string) {
	@link.Link(link.LinkProps{Href: href, Class: class, Attrs: A("data-testid", testid)}) {
		{ label }
	}
}

templ buttonLink(href, class, testid, label string) {
	@button.Button(button.ButtonProps{Href: href, Class: class, Attrs: A("data-testid", testid)}) {
		{ label }
	}
}

templ submit(class, testid, label string) {
	@button.Button(button.ButtonProps{Type: "submit", Class: class, Attrs: A("data-testid", testid)}) {
		{ label }
	}
}

templ footLine(lead, href, testid, label string) {
	@text.Text(text.TextProps{Class: TextMuted}) {
		{ lead }{ " " }
		@authLink(href, LinkSkin(), testid, label)
	}
}

// addonInput: the input + a muted addon text (e.g. the mail domain) in a Group; the addon is rendered and linked via
// aria-describedby only when non-blank (generated widgets: Field addon in authfly/codegen).
templ addonInput(f FieldControl, typ, name, autocomplete, inputID string, required bool, addonID, addon, testid string) {
	@Group("2", "", "", "", nil) {
		@TextInput(f, typ, name, autocomplete, inputID, required, when(addon != "", addonID))
		if addon != "" {
			@text.Text(text.TextProps{Tag: "span", Class: TextMuted, Attrs: A("id", addonID, "data-testid", testid)}) {
				{ addon }
			}
		}
	}
}

templ decision(action, csrf, value, variant, label, testid string) {
	@Form(action, "flex-1", A("data-testid", testid)) {
		@Hidden("csrf", csrf)
		@Hidden("decision", value)
		@button.Button(button.ButtonProps{Type: "submit", Class: ButtonSkin(variant, "w-full")}) {
			{ label }
		}
	}
}

templ AuthflyConsent(p AuthflyConsentProps) {
	{{ id, labels := Str(p.Id), p.Labels }}
	@Card(WidgetCardSkin(), landmark(id, Str(p.LandmarkLabel), "data-testid", "authfly-consent", "data-client", Str(p.Client))) {
		@WidgetHead(id, Str(p.Title), Str(p.Text), "", "")
		@Messages(id, Str(p.Error), Str(p.Info))
		@text.Text(text.TextProps{Class: "text-sm text-foreground", Attrs: A("data-testid", "account")}) {
			{ Lab(labels, "account") }{ " " }
			@text.Text(text.TextProps{Tag: "strong", Class: "font-semibold"}) {
				{ Str(p.Account) }
			}
		}
		@Stack("2", "", "", "", nil) {
			@Title(2, id+"-scopes", "", Lab(labels, "scopes"))
			@box.Box(box.BoxProps{Tag: "ul", Class: "m-0 flex list-none flex-col gap-2 p-0", Attrs: A("aria-labelledby", id+"-scopes", "data-testid", "scopes")}) {
				for _, s := range Items(p.Scopes) {
					@box.Box(box.BoxProps{Tag: "li", Class: "flex items-center gap-2 text-sm text-foreground", Attrs: A("data-scope", s.ID)}) {
						@LucideIcon("check", "")
						{ s.Title }
					}
				}
			}
		}
		@Group("2", "", "between", "", nil) {
			@decision(Str(p.Action), Str(p.Csrf), "deny", "outline", Lab(labels, "deny"), "deny")
			@decision(Str(p.Action), Str(p.Csrf), "approve", "default", Lab(labels, "approve"), "approve")
		}
	}
}

templ AuthflyAccount(p AuthflyAccountProps) {
	{{ id, labels := Str(p.Id), p.Labels }}
	{{ verified := Bool(p.Verified) }}
	@Card(WidgetCardSkin("max-w-lg"), landmark(id, Str(p.LandmarkLabel), "data-testid", "authfly-account")) {
		@WidgetHead(id, Str(p.Title), Str(p.Text), "", "")
		@box.Box(box.BoxProps{Tag: "dl", Class: "m-0 grid gap-4", Attrs: A("data-testid", "profile")}) {
			@box.Box(box.BoxProps{Class: "grid gap-2"}) {
				@box.Box(box.BoxProps{Tag: "dt", Class: TextMuted}) {
					{ Lab(labels, "name") }
				}
				@box.Box(box.BoxProps{Tag: "dd", Class: "m-0 font-semibold text-foreground", Attrs: A("data-testid", "profile-name")}) {
					{ Str(p.Name) }
				}
			}
			@box.Box(box.BoxProps{Class: "grid gap-2"}) {
				@box.Box(box.BoxProps{Tag: "dt", Class: TextMuted}) {
					{ Lab(labels, "email") }
				}
				@box.Box(box.BoxProps{Tag: "dd", Class: "m-0 flex flex-wrap items-center gap-2 font-semibold text-foreground", Attrs: A("data-testid", "profile-email")}) {
					{ Str(p.Email) }
					@Badge(map[bool]string{true: "default", false: "secondary"}[verified], "verified", map[bool]string{true: Lab(labels, "verified"), false: Lab(labels, "unverified")}[verified])
				}
			}
		}
		@separator.Separator(separator.SeparatorProps{Decorative: true, Class: "w-full border-border"})
		@Stack("2", "", "", "", nil) {
			@Title(2, id+"-methods", "", Lab(labels, "security"))
			@box.Box(box.BoxProps{Tag: "ul", Class: "m-0 flex list-none flex-col gap-2 p-0", Attrs: A("aria-labelledby", id+"-methods", "data-testid", "methods")}) {
				for _, m := range Items(p.Methods) {
					@box.Box(box.BoxProps{Tag: "li", Class: "flex items-center justify-between gap-4 text-sm text-foreground", Attrs: A("data-method", m.ID)}) {
						@text.Text(text.TextProps{Tag: "span", Class: "flex items-center gap-2"}) {
							@LucideIcon(or(m.Icon, "shield"), "")
							{ m.Title }
						}
						@Badge("outline", "", m.Text)
					}
				}
			}
		}
		@Form(Str(p.SignoutUrl), "", A("data-testid", "signout-form")) {
			@Hidden("csrf", Str(p.Csrf))
			@button.Button(button.ButtonProps{Type: "submit", Class: ButtonSkin("outline", "w-full"), Attrs: A("data-testid", "signout")}) {
				@LucideIcon("log-out", "")
				{ Lab(labels, "signout") }
			}
		}
	}
}
