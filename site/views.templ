package main

import (
	af "github.com/authfly/authkit/packages/ui/templ/authfly"
	"github.com/authfly/authkit/packages/ui/templ/ui/box"
	"github.com/authfly/authkit/packages/ui/templ/ui/button"
	"github.com/authfly/authkit/packages/ui/templ/ui/link"
	"github.com/authfly/authkit/packages/ui/templ/ui/text"
)

// Docs site views on the UI8Kit 3 templ primitives (ui/*) and the Authfly middle layer (authfly/*); layout and
// type classes are plain tokens (the xgen container/grid/title/list bricks are gone in v3).

// siteDocument is the document skeleton of the static site (the one place with html, head and body).
templ siteDocument(pageTitle string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ pageTitle }</title>
			<link rel="stylesheet" href="assets/app.css"/>
			<script src="assets/theme.js"></script>
		</head>
		<body class="bg-background text-foreground">
			{ children... }
		</body>
	</html>
}

templ siteHeader() {
	@box.Box(box.BoxProps{Tag: "header", Class: "sticky top-0 z-10 w-full border-b border-border bg-background"}) {
		@box.Box(box.BoxProps{Class: "mx-auto flex h-16 w-full max-w-6xl items-center justify-between gap-4 px-4"}) {
			@link.Link(link.LinkProps{Href: "index.html", Class: "flex items-center gap-2 font-semibold"}) {
				@af.LucideIcon("shield-check", "md")
				@text.Text(text.TextProps{Tag: "span"}) {
					Authfly
				}
			}
			@af.Group("4", "center", "", "", nil) {
				@link.Link(link.LinkProps{Href: "architecture.html", Class: "text-sm text-muted-foreground hover:text-foreground"}) {
					Docs
				}
				@link.Link(link.LinkProps{Href: "widgets.html", Class: "text-sm text-muted-foreground hover:text-foreground"}) {
					Widgets
				}
				@themeToggle()
			}
		}
	}
}

templ sidebar(nav []Section, current string) {
	@box.Box(box.BoxProps{Tag: "nav", Class: "flex flex-col gap-6", Attrs: templ.Attributes{"aria-label": "Documentation"}}) {
		for _, sec := range nav {
			@af.Stack("2", "", "", "", nil) {
				@text.Text(text.TextProps{Class: "text-xs font-semibold uppercase text-muted-foreground"}) {
					{ sec.Title }
				}
				@box.Box(box.BoxProps{Tag: "ul", Class: "flex flex-col gap-2"}) {
					for _, p := range sec.Pages {
						@box.Box(box.BoxProps{Tag: "li"}) {
							@link.Link(link.LinkProps{Href: p.Slug + ".html", Class: navClass(p.Slug == current), Attrs: currentAttr(p.Slug == current)}) {
								{ p.Title }
							}
						}
					}
				}
			}
		}
	}
}

templ docPage(nav []Section, page Page, nodes []Node, previews map[string]Preview) {
	@siteDocument(page.Title + " - Authfly") {
		@siteHeader()
		@box.Box(box.BoxProps{Tag: "main", Class: "mx-auto w-full max-w-6xl px-4 py-8"}) {
			@box.Box(box.BoxProps{Class: "grid grid-cols-1 gap-8 sm:grid-cols-2 md:grid-cols-4"}) {
				@box.Box(box.BoxProps{Class: "order-last md:order-first"}) {
					@sidebar(nav, page.Slug)
				}
				@box.Box(box.BoxProps{Class: "min-w-0 md:col-span-3"}) {
					@box.Box(box.BoxProps{Tag: "article", Class: "flex min-w-0 flex-col gap-4"}) {
						for _, n := range nodes {
							@mdNode(n, previews)
						}
					}
				}
			}
		}
	}
}

templ mdNode(n Node, previews map[string]Preview) {
	switch n.Kind {
		case "h1":
			@text.Text(text.TextProps{Tag: "h1", Class: "text-3xl font-bold", Attrs: templ.Attributes{"id": n.Text}}) {
				@spans(n.Spans)
			}
		case "h2":
			@text.Text(text.TextProps{Tag: "h2", Class: "pt-6 text-2xl font-semibold", Attrs: templ.Attributes{"id": n.Text}}) {
				@spans(n.Spans)
			}
		case "h3":
			@text.Text(text.TextProps{Tag: "h3", Class: "pt-2 text-lg font-semibold", Attrs: templ.Attributes{"id": n.Text}}) {
				@spans(n.Spans)
			}
		case "p":
			@text.Text(text.TextProps{Class: "leading-7 text-muted-foreground"}) {
				@spans(n.Spans)
			}
		case "note":
			@box.Box(box.BoxProps{Class: "flex gap-2 rounded bg-muted p-4 text-sm"}) {
				@af.LucideIcon("info", "")
				@text.Text(text.TextProps{Class: "text-sm"}) {
					@spans(n.Spans)
				}
			}
		case "ul", "ol":
			@box.Box(box.BoxProps{Tag: map[bool]string{true: "ol", false: "ul"}[n.Kind == "ol"], Class: listClass(n.Kind)}) {
				for _, it := range n.Items {
					@box.Box(box.BoxProps{Tag: "li", Class: "leading-7"}) {
						@spans(it)
					}
				}
			}
		case "code":
			@text.Text(text.TextProps{Tag: "pre", Class: "overflow-auto rounded bg-muted p-4 text-sm", Attrs: templ.Attributes{"data-lang": n.Lang}}) {
				@text.Text(text.TextProps{Tag: "code"}) {
					{ n.Text }
				}
			}
		case "preview":
			if p, ok := previews[n.Text]; ok {
				@previewFrame(p)
			}
	}
}

templ spans(xs []Inline) {
	for _, x := range xs {
		switch x.Kind {
			case "code":
				@text.Text(text.TextProps{Tag: "code", Class: "rounded bg-muted px-2 text-sm text-foreground"}) {
					{ x.Text }
				}
			case "strong":
				@text.Text(text.TextProps{Tag: "strong", Class: "font-semibold text-foreground"}) {
					{ x.Text }
				}
			case "link":
				@link.Link(link.LinkProps{Href: x.Href, External: isExternal(x.Href), Class: "font-medium text-primary underline underline-offset-4"}) {
					{ x.Text }
				}
			default:
				{ x.Text }
		}
	}
}

// previewFrame shows a widget rendered live by the generated templ set, framed like the docs examples of ui8kit.
templ previewFrame(p Preview) {
	@box.Box(box.BoxProps{Tag: "figure", Class: "flex flex-col overflow-hidden rounded inset-ring inset-ring-border", Attrs: templ.Attributes{"data-preview": p.Slug, "id": "preview-" + p.Slug}}) {
		@box.Box(box.BoxProps{Class: "flex flex-wrap items-center justify-between gap-2 border-b border-border px-4 py-2"}) {
			@text.Text(text.TextProps{Class: "text-sm font-semibold"}) {
				{ p.Name }
			}
			@af.Badge("secondary", "", "Live, templ")
		}
		@box.Box(box.BoxProps{Class: "bg-background px-4 py-8"}) {
			@p.Widget
		}
		@text.Text(text.TextProps{Tag: "figcaption", Class: "border-t border-border px-4 py-2 text-sm text-muted-foreground"}) {
			{ p.Note }
		}
	}
}

templ widgetsPage(nav []Section, page Page, intro []Node, all []Preview) {
	@siteDocument("Widgets - Authfly") {
		@siteHeader()
		@box.Box(box.BoxProps{Tag: "main", Class: "mx-auto w-full max-w-6xl px-4 py-8"}) {
			@box.Box(box.BoxProps{Class: "grid grid-cols-1 gap-8 sm:grid-cols-2 md:grid-cols-4"}) {
				@box.Box(box.BoxProps{Class: "order-last md:order-first"}) {
					@sidebar(nav, page.Slug)
				}
				@box.Box(box.BoxProps{Class: "min-w-0 md:col-span-3"}) {
					@box.Box(box.BoxProps{Tag: "article", Class: "flex min-w-0 flex-col gap-4"}) {
						for _, n := range intro {
							@mdNode(n, nil)
						}
						for _, p := range all {
							@previewFrame(p)
						}
					}
				}
			}
		}
	}
}

templ homePage(nav []Section, runtimes []Page, hero Preview) {
	@siteDocument("Authfly widgets - sign-in UI for eight runtimes") {
		@siteHeader()
		@box.Box(box.BoxProps{Tag: "main", Class: "mx-auto flex w-full max-w-6xl flex-col gap-16 px-4 py-12"}) {
			@box.Box(box.BoxProps{Class: "grid grid-cols-1 items-center gap-12 md:grid-cols-2"}) {
				@af.Stack("6", "start", "", "", nil) {
					@af.Badge("outline", "", "Self-hosted, MIT")
					@text.Text(text.TextProps{Tag: "h1", Class: "text-4xl font-bold"}) {
						Sign-in widgets for every stack
					}
					@text.Text(text.TextProps{Class: "text-lg text-muted-foreground"}) {
						Sign-in, sign-up, magic link, password reset, account and consent widgets, built on UI8Kit 3 primitives for eight runtimes with the same DOM. Plain forms: post them to any backend.
					}
					@af.Group("4", "center", "", "flex-wrap", nil) {
						@link.Link(link.LinkProps{Href: "architecture.html", Class: "inline-flex h-10 items-center rounded bg-primary px-4 text-sm font-medium text-primary-foreground"}) {
							Get started
						}
						@link.Link(link.LinkProps{Href: "widgets.html", Class: "inline-flex h-10 items-center rounded px-4 text-sm font-medium inset-ring inset-ring-border"}) {
							See the widgets
						}
					}
				}
				@box.Box(box.BoxProps{Class: "rounded bg-muted px-4 py-8"}) {
					@hero.Widget
				}
			}
			@af.Stack("6", "", "", "", nil) {
				@text.Text(text.TextProps{Tag: "h2", Class: "text-2xl font-semibold"}) {
					Pick your runtime
				}
				@box.Box(box.BoxProps{Class: "grid grid-cols-2 gap-4 md:grid-cols-4"}) {
					for _, r := range runtimes {
						@link.Link(link.LinkProps{Href: r.Slug + ".html", Class: "flex flex-col gap-2 rounded p-4 inset-ring inset-ring-border hover:bg-muted"}) {
							@text.Text(text.TextProps{Tag: "span", Class: "font-semibold"}) {
								{ r.Title }
							}
							@text.Text(text.TextProps{Tag: "span", Class: "text-sm text-muted-foreground"}) {
								{ r.Blurb }
							}
						}
					}
				}
			}
			@box.Box(box.BoxProps{Class: "grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3"}) {
				@feature("file-code", "Plain HTML forms", "Every widget is a form with named fields and a documented contract; no client library is needed.")
				@feature("layers", "One DOM, eight runtimes", "React, Svelte, Vue, Solid, templ, Twig, Latte and Jinja2 widgets, checked by the DOM parity gate.")
				@feature("palette", "shadcn tokens", "Light and dark themes from CSS variables, Lucide icons, mobile first.")
			}
		}
	}
}

templ feature(icon, head, body string) {
	@af.Stack("2", "", "", "rounded p-6 inset-ring inset-ring-border", nil) {
		@af.LucideIcon(icon, "md")
		@text.Text(text.TextProps{Class: "font-semibold"}) {
			{ head }
		}
		@text.Text(text.TextProps{Class: "text-sm text-muted-foreground"}) {
			{ body }
		}
	}
}

// themeToggle: the Button primitive wired by site/theme.js ([data-ui8kit="theme-toggle"], aria-pressed).
templ themeToggle() {
	@button.Button(button.ButtonProps{Type: "button", Class: af.ButtonSkin("ghost", "w-10 px-0"), AriaLabel: "Dark mode", AriaPressed: "false", Attrs: templ.Attributes{"data-ui8kit": "theme-toggle", "data-testid": "theme-toggle"}}) {
		@text.Text(text.TextProps{Tag: "span", Class: "dark:hidden"}) {
			@af.LucideIcon("moon", "md")
		}
		@text.Text(text.TextProps{Tag: "span", Class: "hidden dark:inline"}) {
			@af.LucideIcon("sun", "md")
		}
	}
}
